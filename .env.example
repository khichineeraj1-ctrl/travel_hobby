# Public site URL — used for canonical URLs, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Admin login password (/admin). Required before going live.
ADMIN_PASSWORD=change-me

# Optional: separate secret for signing admin sessions (defaults to one derived from the password)
# ADMIN_SECRET=

# Optional: use demo weather instead of calling open-meteo.com
# WEATHER_MOCK=1
